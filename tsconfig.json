{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "jev-msw": ["./src/index.ts"],
      "jev-msw/node": ["./src/node.ts"],
      "jev-msw/vitest": ["./src/vitest.ts"],
      "jev-msw/jest": ["./src/jest.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tests", "examples", "tsup.config.ts", "vitest.config.ts", "eslint.config.js"]
}
